<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ifni.weather" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>طقس إفني</name>
    <description>تطبيق توقعات الطقس والبحري لسيدي إفني</description>
    <author email="dev@example.com" href="http://example.com">Adil</author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- أيقونة التطبيق الرئيسية -->
    <icon src="res/icon.png" />

    <platform name="android">
        <!-- وضع أيقونة التطبيق فقط داخل المربع المخصص من أندرويد لمنع الاقتصاص -->
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#e8ecef" />
    </platform>

</widget>
